<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>Contact Us Email</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
  <table>
    <tbody>
    <tr class="p-5" style="display:block;padding: 10px;">
        <th style="display:inline-flex;padding: 10px;">Name</th>
        <td style="display:inline-flex;padding: 10px;">{{name}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 10px;">
        <th style="display:inline-flex;padding: 10px;">Phone</th>
        <td style="display:inline-flex;padding: 10px;">{{phone}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 10px;">
        <th style="display:inline-flex;padding: 10px;">Email</th>
        <td style="display:inline-flex;padding: 10px;">{{email}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 10px;">
        <th style="display:inline-flex;padding: 10px;">Country</th>
        <td style="display:inline-flex;padding: 10px;">{{country}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 10px;">
        <th style="display:inline-flex;padding: 10px;">Service</th>
        <td style="display:inline-flex;padding: 10px;">{{service}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 10px;">
        <th style="display:inline-flex;padding: 10px;">Message</th>
        <td style="display:inline-flex;padding: 10px;">{{message}}</td>
    </tr>
    </tbody>
  </table>
  <!-- Latest compiled and minified JavaScript -->
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>