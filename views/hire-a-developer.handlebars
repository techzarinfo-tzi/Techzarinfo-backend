<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>Contact Us Email</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
  <h4>Dear {{name}},</h4>
  <p>Thank you for contacting us!. Our team will be contact you shortly</p>
  <p>We have received your contact with following details</p>
  <table>
    <tbody>
    <tr class="p-5" style="display:block;padding: 5px;">
        <th style="display:inline-flex;padding: 5px;">Name</th>
        <td style="display:inline-flex;padding: 5px;">{{name}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 5px;">
        <th style="display:inline-flex;padding: 5px;">Phone</th>
        <td style="display:inline-flex;padding: 5px;">{{phone}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 5px;">
        <th style="display:inline-flex;padding: 5px;">Email</th>
        <td style="display:inline-flex;padding: 5px;">{{email}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 5px;">
        <th style="display:inline-flex;padding: 5px;">Company</th>
        <td style="display:inline-flex;padding: 5px;">{{company}}</td>
    </tr>
    <tr class="p-5" style="display:block;padding: 5px;">
        <th style="display:inline-flex;padding: 5px;">Message</th>
        <td style="display:inline-flex;padding: 5px;">{{message}}</td>
    </tr>
    </tbody>
  </table>
  <!-- Latest compiled and minified JavaScript -->
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>